<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TapoMaui.Views.RTSPVideoViewer"
             x:Name="VideoViewerControl">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video Display Area -->
        <Border Grid.Row="0" 
                BackgroundColor="Black"
                Stroke="Gray"
                StrokeThickness="1">
            
            <Grid>
                <!-- Main video display using Image for JPEG frames -->
                <Image x:Name="VideoImage"
                       Aspect="AspectFit"
                       HorizontalOptions="FillAndExpand"
                       VerticalOptions="FillAndExpand"
                       BackgroundColor="Black" />

                <!-- Loading overlay -->
                <StackLayout x:Name="LoadingOverlay"
                           IsVisible="True"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           BackgroundColor="Black">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                     IsRunning="True"
                                     Color="Orange"
                                     WidthRequest="50"
                                     HeightRequest="50" />
                    <Label x:Name="StatusLabel"
                           Text="Connecting to RTSP stream..."
                           FontSize="16"
                           TextColor="Orange"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0" />
                </StackLayout>

                <!-- Error overlay -->
                <StackLayout x:Name="ErrorOverlay"
                           IsVisible="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           BackgroundColor="Black"
                           Padding="20">
                    <Label Text="📹" 
                           FontSize="48"
                           TextColor="Red"
                           HorizontalOptions="Center" />
                    <Label x:Name="ErrorLabel"
                           Text="Connection failed"
                           FontSize="16"
                           TextColor="Red"
                           HorizontalOptions="Center"
                           TextAlignment="Center"
                           Margin="0,10,0,0" />
                    <Button x:Name="RetryButton"
                            Text="Retry Connection"
                            BackgroundColor="Orange"
                            TextColor="White"
                            FontSize="14"
                            Margin="0,15,0,0"
                            Clicked="OnRetryClicked" />
                </StackLayout>

                <!-- Connection info overlay (top-left) -->
                <StackLayout x:Name="InfoOverlay"
                           IsVisible="False"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           BackgroundColor="#80000000"
                           Padding="10"
                           Margin="10">
                    <Label x:Name="ConnectionInfoLabel"
                           Text="🔴 LIVE"
                           FontSize="12"
                           TextColor="Lime"
                           FontAttributes="Bold" />
                    <Label x:Name="ResolutionLabel"
                           Text="1920x1080"
                           FontSize="10"
                           TextColor="White" />
                    <Label x:Name="CodecLabel"
                           Text="H.264"
                           FontSize="10"
                           TextColor="White" />
                </StackLayout>
            </Grid>
        </Border>

        <!-- Control Panel -->
        <StackLayout Grid.Row="1"
                    Orientation="Horizontal"
                    Padding="10"
                    BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2D2D30}">
            
            <Button x:Name="ConnectButton"
                    Text="Connect"
                    BackgroundColor="Green"
                    TextColor="White"
                    FontSize="14"
                    Margin="0,0,10,0"
                    Clicked="OnConnectClicked" />
            
            <Button x:Name="DisconnectButton"
                    Text="Disconnect"
                    BackgroundColor="Red"
                    TextColor="White"
                    FontSize="14"
                    IsEnabled="False"
                    Margin="0,0,10,0"
                    Clicked="OnDisconnectClicked" />
            
            <Button x:Name="FullscreenButton"
                    Text="Fullscreen"
                    BackgroundColor="Blue"
                    TextColor="White"
                    FontSize="14"
                    IsEnabled="False"
                    Margin="0,0,10,0"
                    Clicked="OnFullscreenClicked" />

            <Label x:Name="FpsLabel"
                   Text="0 FPS"
                   FontSize="12"
                   TextColor="Gray"
                   VerticalOptions="Center"
                   Margin="10,0,0,0" />
        </StackLayout>
    </Grid>
</ContentView>