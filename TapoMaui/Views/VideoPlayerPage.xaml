<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:media="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui.MediaElement"
             xmlns:views="clr-namespace:TapoMaui.Views"
             xmlns:vm="clr-namespace:TapoMaui.ViewModels"
             x:Class="TapoMaui.Views.VideoPlayerPage"
             x:DataType="vm:DeviceItemViewModel"
             Title="{Binding Title, StringFormat='📹 {0}'}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video Player Selection -->
        <Border Grid.Row="0" 
                BackgroundColor="Black"
                Margin="10">
            
            <Grid>
                <!-- RTSP Native Player (Primary) -->
                <views:RTSPVideoViewer x:Name="RtspViewer"
                                      IsVisible="True" />
                
                <!-- MediaElement Fallback (Limited RTSP support) -->
                <StackLayout x:Name="MediaElementContainer"
                           IsVisible="False">
                    <Label Text="⚠️ Using MediaElement (Limited RTSP Support)" 
                           FontSize="12" 
                           TextColor="Orange" 
                           HorizontalOptions="Center" 
                           Margin="0,10,0,0" />
                    
                    <media:MediaElement x:Name="VideoPlayer"
                                       Source="{Binding StreamUrl}"
                                       ShouldAutoPlay="True"
                                       ShouldShowPlaybackControls="True"
                                       ShouldKeepScreenOn="True"
                                       BackgroundColor="Black"
                                       HorizontalOptions="FillAndExpand"
                                       VerticalOptions="FillAndExpand" />
                </StackLayout>
                
                <!-- Loading indicator for stream -->
                <StackLayout IsVisible="{Binding IsStreamLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           BackgroundColor="Black">
                    <ActivityIndicator IsRunning="{Binding IsStreamLoading}"
                                     Color="Orange"
                                     WidthRequest="40"
                                     HeightRequest="40"
                                     HorizontalOptions="Center" />
                    <Label Text="🔄 Connecting to camera..." 
                           FontSize="16"
                           TextColor="Orange"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0" />
                    <Label Text="{Binding Device.IpAddress, StringFormat='Connecting to {0}...'}" 
                           FontSize="12"
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Grid>
        </Border>

        <!-- Controls -->
        <StackLayout Grid.Row="1" 
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D30}">
            
            <!-- Camera Info -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackLayout Grid.Column="0">
                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding Device.IpAddress}" FontSize="12" TextColor="Gray" />
                </StackLayout>
                
                <Label Grid.Column="1"
                       Text="{Binding IsStreaming, Converter={StaticResource StreamStatusConverter}}"
                       FontSize="14"
                       TextColor="{Binding IsStreaming, Converter={StaticResource StreamStatusColorConverter}}"
                       VerticalOptions="Center" />
            </Grid>
            
            <!-- Stream Controls -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0"
                        Text="{Binding IsStreaming, Converter={StaticResource StreamButtonTextConverter}}"
                        Command="{Binding ToggleVideoPlayerCommand}"
                        IsEnabled="{Binding IsStreamLoading, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{Binding IsStreaming, Converter={StaticResource StreamButtonColorConverter}}"
                        TextColor="White"
                        FontSize="12"
                        HeightRequest="45"
                        Margin="0,0,5,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStreamLoading}" Value="True">
                            <Setter Property="Text" Value="Connecting..." />
                            <Setter Property="BackgroundColor" Value="Orange" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                
                <Button Grid.Column="1"
                        Text="Native RTSP"
                        Clicked="OnNativeRTSPClicked"
                        BackgroundColor="DarkGreen"
                        TextColor="White"
                        FontSize="12"
                        HeightRequest="45"
                        Margin="2.5,0" />
                
                <Button Grid.Column="2"
                        Text="Open VLC"
                        Clicked="OnOpenVLCClicked"
                        BackgroundColor="DarkOrange"
                        TextColor="White"
                        FontSize="12"
                        HeightRequest="45"
                        Margin="2.5,0" />
                
                <Button Grid.Column="3"
                        Text="Close"
                        Clicked="OnCloseClicked"
                        BackgroundColor="Gray"
                        TextColor="White"
                        FontSize="12"
                        HeightRequest="45"
                        Margin="5,0,0,0" />
            </Grid>
            
            <!-- Player Selection -->
            <StackLayout Orientation="Horizontal" 
                        HorizontalOptions="Center"
                        Margin="0,0,0,10">
                <Label Text="Video Player:" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                <Switch x:Name="PlayerModeSwitch" 
                        IsToggled="True"
                        Toggled="OnPlayerModeChanged"
                        Margin="10,0,0,0" />
                <Label x:Name="PlayerModeLabel" 
                       Text="Native RTSP Client"
                       FontSize="12" 
                       TextColor="Green"
                       FontAttributes="Bold"
                       VerticalOptions="Center" 
                       Margin="10,0,0,0" />
            </StackLayout>
            
            <!-- Stream Quality Info -->
            <StackLayout IsVisible="{Binding IsStreaming}" 
                        Margin="0,10,0,0">
                <Label Text="Stream Information" FontSize="14" FontAttributes="Bold" />
                <Label Text="📡 Using RtspClientSharp - Full RTSP support with H.264/H.265/MJPEG" FontSize="12" TextColor="Green" />
                <Label Text="{Binding StreamUrl, StringFormat='URL: {0}'}" 
                       FontSize="10" 
                       TextColor="Gray"
                       LineBreakMode="MiddleTruncation" />
                
                <!-- RTSP Help -->
                <StackLayout Margin="0,10,0,0">
                    <Label Text="📱 New: Native RTSP Player Features:" FontSize="12" FontAttributes="Bold" TextColor="Green" />
                    <Label Text="• Direct RTSP connection without MediaElement limitations" FontSize="10" TextColor="Gray" />
                    <Label Text="• Support for H.264, H.265, and MJPEG video codecs" FontSize="10" TextColor="Gray" />
                    <Label Text="• Real-time FPS counter and connection status" FontSize="10" TextColor="Gray" />
                    <Label Text="• Fallback to MediaElement if RTSP client fails" FontSize="10" TextColor="Gray" />
                </StackLayout>
            </StackLayout>
            
            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   Margin="0,10,0,0" />
        </StackLayout>
    </Grid>
</ContentPage>