<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TapoMaui.ViewModels"
             xmlns:models="clr-namespace:TapoMaui.Models"
             x:Class="TapoMaui.Views.DeviceItemView"
             x:DataType="vm:DeviceItemViewModel">

    <Frame Padding="15" Margin="10,5" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" 
           CornerRadius="8"
           HasShadow="True">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- Device Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackLayout Grid.Column="0">
                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding Device.DeviceInfo.Model}" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding Device.IpAddress}" FontSize="11" TextColor="Gray" />
                </StackLayout>
                
                <Switch Grid.Column="1" 
                        IsToggled="{Binding IsOn}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Margin="10,0" />
                
                <Button Grid.Column="2"
                        Text="Toggle"
                        Command="{Binding TogglePowerCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{Binding IsOn, Converter={StaticResource BoolToColorConverter}}"
                        TextColor="White"
                        FontSize="12"
                        Padding="10,5" />
            </Grid>
            
            <!-- Brightness Control -->
            <StackLayout Grid.Row="1" 
                         IsVisible="{Binding HasBrightness}"
                         Margin="0,5">
                <Label Text="{Binding Brightness, StringFormat='Brightness: {0}%'}" FontSize="14" />
                <Slider Value="{Binding Brightness}"
                        Minimum="1"
                        Maximum="100"
                        ValueChanged="OnBrightnessChanged" />
            </StackLayout>
            
            <!-- Color Controls -->
            <StackLayout Grid.Row="2" 
                         IsVisible="{Binding IsColorDevice}"
                         Margin="0,10">
                <Label Text="Colors" FontSize="14" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding AvailableColors}"
                               HeightRequest="50">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Color">
                <Button Text="{Binding Name}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeviceItemViewModel}}, Path=SetColorCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Gray"
                                    TextColor="White"
                                    FontSize="10"
                                    WidthRequest="60"
                                    HeightRequest="40" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <Label Text="{Binding ColorTemperature, StringFormat='Color Temperature: {0}K'}" 
                       FontSize="14" 
                       Margin="0,10,0,0" />
                <Slider Value="{Binding ColorTemperature}"
                        Minimum="2500"
                        Maximum="6500"
                        ValueChanged="OnColorTemperatureChanged" />
            </StackLayout>
            
            <!-- Energy Monitoring -->
            <StackLayout Grid.Row="3" 
                         IsVisible="{Binding IsEnergyMonitoringDevice}"
                         Margin="0,10">
                <Label Text="Energy Monitoring" FontSize="14" FontAttributes="Bold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Text="{Binding CurrentPower, StringFormat='Power: {0}'}" FontSize="12" />
                    <Label Grid.Column="1" Text="{Binding EnergyUsage}" FontSize="12" />
                </Grid>
            </StackLayout>
            
            <!-- Loading Indicator -->
            <ActivityIndicator IsVisible="{Binding IsBusy}"
                               IsRunning="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               Grid.RowSpan="4" />
        </Grid>
    </Frame>
</ContentView>