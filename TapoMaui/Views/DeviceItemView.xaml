<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TapoMaui.ViewModels"
             xmlns:models="clr-namespace:TapoMaui.Models"
             x:Class="TapoMaui.Views.DeviceItemView"
             x:DataType="vm:DeviceItemViewModel">

    <Frame Padding="15" Margin="10,5" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" 
           CornerRadius="8"
           HasShadow="True">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- Device Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackLayout Grid.Column="0">
                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding Device.DeviceInfo.Model}" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding Device.IpAddress}" FontSize="11" TextColor="Gray" />
                </StackLayout>
                
                <Switch Grid.Column="1" 
                        IsToggled="{Binding IsOn}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Margin="10,0" />
                
                <Button Grid.Column="2"
                        Text="Toggle"
                        Command="{Binding TogglePowerCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{Binding IsOn, Converter={StaticResource BoolToColorConverter}}"
                        TextColor="White"
                        FontSize="12"
                        Padding="10,5" />
            </Grid>
            
            <!-- Brightness Control -->
            <StackLayout Grid.Row="1" 
                         IsVisible="{Binding HasBrightness}"
                         Margin="0,5">
                <Label Text="{Binding Brightness, StringFormat='Brightness: {0}%'}" FontSize="14" />
                <Slider Value="{Binding Brightness}"
                        Minimum="1"
                        Maximum="100"
                        ValueChanged="OnBrightnessChanged" />
            </StackLayout>
            
            <!-- Color Controls -->
            <StackLayout Grid.Row="2" 
                         IsVisible="{Binding IsColorDevice}"
                         Margin="0,10">
                <Label Text="Colors" FontSize="14" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding AvailableColors}"
                               HeightRequest="50">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Color">
                <Button Text="{Binding Name}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeviceItemViewModel}}, Path=SetColorCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Gray"
                                    TextColor="White"
                                    FontSize="10"
                                    WidthRequest="60"
                                    HeightRequest="40" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <Label Text="{Binding ColorTemperature, StringFormat='Color Temperature: {0}K'}" 
                       FontSize="14" 
                       Margin="0,10,0,0" />
                <Slider Value="{Binding ColorTemperature}"
                        Minimum="2500"
                        Maximum="6500"
                        ValueChanged="OnColorTemperatureChanged" />
            </StackLayout>
            
            <!-- Energy Monitoring -->
            <StackLayout Grid.Row="3" 
                         IsVisible="{Binding IsEnergyMonitoringDevice}"
                         Margin="0,10">
                <Label Text="Energy Monitoring" FontSize="14" FontAttributes="Bold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Text="{Binding CurrentPower, StringFormat='Power: {0}'}" FontSize="12" />
                    <Label Grid.Column="1" Text="{Binding EnergyUsage}" FontSize="12" />
                </Grid>
            </StackLayout>
            
            <!-- Camera Streaming Controls -->
            <StackLayout Grid.Row="3" 
                         IsVisible="{Binding IsCamera}"
                         Margin="0,10">
                <Label Text="Camera Controls" FontSize="14" FontAttributes="Bold" />
                
                <!-- Main Controls Row -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Start/Stop Stream Button -->
                    <Button Grid.Column="0"
                            Text="{Binding IsStreamLoading, Converter={StaticResource StreamButtonTextConverter}, ConverterParameter=loading}"
                            Command="{Binding ToggleVideoPlayerCommand}"
                            IsEnabled="{Binding IsStreamLoading, Converter={StaticResource StreamButtonEnabledConverter}}"
                            BackgroundColor="{Binding IsStreamLoading, Converter={StaticResource StreamButtonColorConverter}, ConverterParameter=loading}"
                            TextColor="White"
                            FontSize="9"
                            Margin="0,0,2,0" />
                    
                    <!-- View Stream Button -->
                    <Button Grid.Column="1"
                            Text="View Stream"
                            Command="{Binding OpenVideoPlayerCommand}"
                            IsEnabled="{Binding IsStreamLoading, Converter={StaticResource StreamButtonEnabledConverter}}"
                            BackgroundColor="Purple"
                            TextColor="White"
                            FontSize="9"
                            Margin="2,0" />
                    
                    <!-- Test Connection Button -->
                    <Button Grid.Column="2"
                            Text="Test"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding IsStreamLoading, Converter={StaticResource StreamButtonEnabledConverter}}"
                            BackgroundColor="DarkGreen"
                            TextColor="White"
                            FontSize="9"
                            Margin="2,0,0,0" />
                </Grid>
                
                <!-- Status Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Loading Indicator -->
                    <ActivityIndicator Grid.Column="0"
                                      IsVisible="{Binding IsStreamLoading}"
                                      IsRunning="{Binding IsStreamLoading}"
                                      Color="Orange"
                                      WidthRequest="16"
                                      HeightRequest="16"
                                      VerticalOptions="Center"
                                      Margin="0,0,5,0" />
                    
                    <!-- Status Labels -->
                    <StackLayout Grid.Column="1" 
                                Orientation="Horizontal"
                                VerticalOptions="Center">
                        
                        <!-- Loading Status -->
                        <Label Text="{Binding IsStreamLoading, Converter={StaticResource StreamStatusConverter}, ConverterParameter=loading}"
                               FontSize="9"
                               TextColor="{Binding IsStreamLoading, Converter={StaticResource StreamStatusColorConverter}, ConverterParameter=loading}"
                               IsVisible="{Binding IsStreamLoading}" />
                        
                        <!-- Stream Status (when not loading) -->
                        <Label Text="{Binding IsStreaming, Converter={StaticResource StreamStatusConverter}}"
                               FontSize="9"
                               TextColor="{Binding IsStreaming, Converter={StaticResource StreamStatusColorConverter}}"
                               IsVisible="{Binding IsStreamLoading, Converter={StaticResource InvertedBoolConverter}}" />
                    </StackLayout>
                </Grid>
            </StackLayout>
            
            <!-- Loading Indicator -->
            <ActivityIndicator IsVisible="{Binding IsBusy}"
                               IsRunning="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               Grid.RowSpan="4" />
        </Grid>
    </Frame>
</ContentView>