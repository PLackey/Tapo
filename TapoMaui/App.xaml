<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TapoMaui"
             xmlns:converters="clr-namespace:TapoMaui.Converters"
             x:Class="TapoMaui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Value Converters -->
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:ColorToColorConverter x:Key="ColorToColorConverter" />
            <converters:StreamButtonTextConverter x:Key="StreamButtonTextConverter" />
            <converters:StreamButtonColorConverter x:Key="StreamButtonColorConverter" />
            <converters:StreamStatusConverter x:Key="StreamStatusConverter" />
            <converters:StreamStatusColorConverter x:Key="StreamStatusColorConverter" />
            <converters:StreamButtonEnabledConverter x:Key="StreamButtonEnabledConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>